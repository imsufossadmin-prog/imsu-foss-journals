# Public: embedded in browser bundles. These are safe only for the Supabase
# publishable credential, never a secret or service-role credential.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth client credentials are configured in the Supabase dashboard,
# not in this application environment file.

# Server-only: use a direct or Supavisor session-mode URL for a VPS deployment.
DATABASE_URL=

# Server-only and optional at runtime. Required only by the controlled
# development-user provisioning command.
SUPABASE_SECRET_KEY=

# Provisioning only. Do not commit a value; provide it in the shell when running
# npm run db:provision-user.
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
DEV_USER_DISPLAY_NAME=
DEV_USER_ROLE=
DEV_USER_JOURNAL_SLUG=
